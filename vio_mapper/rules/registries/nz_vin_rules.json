  "sources": {
    "nzta": {
      "title": "NZTA VIN layouts",
      "url": "https://www.nzta.govt.nz/vehicles/vehicle-registration/vin",
      "scope": "Official NZTA diagrams; pre/post 29 November 2009. The layouts are published only as two images, VIN-pic-1.jpg and VIN-pic-2.jpg; the page text states no character position. Every position meaning recorded here is a reading of those two pictures, transcribed box by box in the stored copy. The stored copy also carries NZTA's own statement of the length and character set, from VIRM 1-1 VIN and chassis number, which is what the decoder validates against.",
      "accessed": "2026-09-13",
      "retrieval_note": "The live site refuses automated requests (HTTP 403), so the images were retrieved through the Internet Archive. They are byte-identical in the captures of 2025-02-12 and 2026-02-21: VIN-pic-1.jpg sha256 e2ded28ca9332eada6dabc1ef8b1af8d6816cd54e429fe8fcce6928cd899ed9a, VIN-pic-2.jpg sha256 ed4c983e03cc734d3d37915efbe8066b21d967e603f73eb34fdd69915afed365.",
      "local_copy": "docs/rule-sources/nz/nzta_vin_layouts.md",
      "sha256": "0311a8bda6dab5717ca5d666efba7510365adf996393f0965275ce10dbef817b"
    },
    "nissan": {
