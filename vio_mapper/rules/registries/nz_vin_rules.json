    "nzta_virm_attributes": {
      "title": "NZTA VIRM, entry certification 2-2 Vehicle attributes definitions (Table 2-2-1)",
      "url": "https://vehicleinspection.nzta.govt.nz/virms/entry-certification/pre-reg-and-vin/vehicle-attributes/vehicle-attributes-definitions",
      "scope": "Table 2-2-1, LANDATA-defined vehicle types: the 14 two-digit codes and the type each denotes. LANDATA is the system that assigns a 7A8/7AT VIN, and this code is what such a VIN carries at positions 8-9.",
      "accessed": "2026-09-13",
      "local_copy": "docs/rule-sources/nz/nzta_virm_attributes.md",
      "sha256": "480a28f20fc0ea079e6469e667310752fe0df2fe39cd79e6eb0c047c5bba6d07"
